#!/usr/bin/env sh
set -eu

script_path="$0"
script_dir=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
root=$(CDPATH= cd -- "$script_dir/.." && pwd)
script_name=$(basename -- "$0")

usage() {
  cat <<'EOF'
Usage:
  orca goal <outcome> [--pack NAME] [--auto] [--max-cycles N] [--until blocked|done] [--plan-only]
  orca goal --packs [--verbose]
  orca progress
  orca unify
  orca notion sync [--dry-run] [--json] [PAYLOAD|--all]
  orca notion outbox [--json]
  orca notion handoff --issue TITLE [--status STATUS] [--note TEXT] [--json]
  orca notion payload --example
  orca notion payload --validate PATH [--json]
  orca notion adapter --check PAYLOAD
  orca notion adapter --json-check PAYLOAD
  orca notion adapter --doctor PAYLOAD
  orca notion adapter --dry-run PAYLOAD
  orca notion doctor [--strict] [--json]
  orca backend status [--json]
  orca help
  orca list
  orca show <command>
  orca path <command>
  orca run <command> [--print] [--harness codex|generic] [--target DIR] [--sandbox MODE] [--output FILE] [--] [context...]

Installed shims such as `orca-onboard` and `orca-build` call `orca run <command>`.

Examples:
  orca goal --packs
  orca goal --packs --verbose
  orca goal "make this production ready" --pack release-ready
  orca goal "make this production ready" --pack release-ready --plan-only
  orca goal "make this production ready" --pack release-ready --auto --max-cycles 5
  orca progress
  orca unify
  orca notion sync --dry-run --json --all
  orca notion outbox --json
  orca notion handoff --issue "Update Notion issue after PR merge" --status Done --note "Live Notion unavailable; queued local handoff."
  orca notion handoff --json --issue "Update Notion issue after PR merge" --status Done
  orca notion payload --example
  orca notion payload --validate .orca/notion/outbox/payload.json
  orca notion adapter --check .orca/notion/outbox/payload.json
  orca notion adapter --json-check .orca/notion/outbox/payload.json
  orca notion adapter --doctor .orca/notion/outbox/payload.json
  orca notion sync --all
  orca notion doctor [--strict] [--json]
  orca list
  orca show orca-build
  orca run orca-onboard --print -- "Build a small iOS settings screen"
  orca-build --harness codex --target /path/to/repo -- "Implement the approved plan"
EOF
}

list_commands() {
  find "$root/commands" -type f -name 'orca-*.md' | sed "s#^$root/commands/##" | sed 's/\.md$//' | sort
}

normalize_command() {
  name="$1"
  case "$name" in
    "") return 1 ;;
    *.md) name=${name%.md} ;;
  esac
  case "$name" in
    orca-*) ;;
    *) name="orca-$name" ;;
  esac
  printf '%s\n' "$name"
}

command_file() {
  name=$(normalize_command "$1") || return 1
  file="$root/commands/$name.md"
  [ -f "$file" ] || {
    printf 'Unknown ORCA command: %s\n' "$name" >&2
    exit 1
  }
  printf '%s\n' "$file"
}

emit_prompt() {
  name="$1"
  file="$2"
  context="$3"

  printf 'Follow the ORCA Framework workflow command `%s`.\n\n' "$name"
  printf 'Execution rules:\n'
  printf -- '- Prefer Notion-backed PM/docs/issues when configured.\n'
  printf -- '- If Notion is unavailable, continue with `.orca/` markdown fallback and say so explicitly.\n'
  printf -- '- Keep Linear optional; use it only when explicitly selected or already canonical for this work.\n'
  printf -- '- Use the command definition below as the source of truth.\n'
  printf -- '- End with a concise completion summary that states outcome, verification, blockers, and next step.\n\n'
  printf 'Command definition:\n\n'
  cat "$file"
  if [ -n "$context" ]; then
    printf '\n\nAdditional context:\n\n%s\n' "$context"
  fi
}

run_codex() {
  name="$1"
  file="$2"
  target="$3"
  sandbox="$4"
  output_file="$5"
  context="$6"

  command -v codex >/dev/null 2>&1 || {
    printf 'Codex CLI is not installed. Use --print to inspect the ORCA prompt.\n' >&2
    exit 1
  }

  prompt_file=$(mktemp "${TMPDIR:-/tmp}/orca-prompt.XXXXXX")
  trap 'rm -f "$prompt_file"' EXIT INT TERM HUP
  emit_prompt "$name" "$file" "$context" > "$prompt_file"

  if [ -n "$output_file" ]; then
    codex exec \
      --ignore-user-config \
      --skip-git-repo-check \
      --sandbox "$sandbox" \
      -C "$target" \
      -o "$output_file" \
      - < "$prompt_file"
  else
    codex exec \
      --ignore-user-config \
      --skip-git-repo-check \
      --sandbox "$sandbox" \
      -C "$target" \
      - < "$prompt_file"
  fi
}

orca_dir() {
  printf '%s\n' "${ORCA_ROOT:-.orca}"
}

notion_dir() {
  printf '%s/notion\n' "$(orca_dir)"
}

count_json_files() {
  dir="$1"
  [ -d "$dir" ] || {
    printf '0\n'
    return 0
  }
  /usr/bin/find "$dir" -type f -name '*.json' | wc -l | tr -d ' '
}

now_utc() {
  date -u '+%Y-%m-%dT%H:%M:%SZ'
}

slugify() {
  printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//' | cut -c 1-60
}

shell_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

ruby_json() {
  RUBYOPT="${RUBYOPT:+$RUBYOPT }--disable-gems" ruby -rjson "$@"
}

json_escape() {
  if command -v ruby >/dev/null 2>&1; then
    ruby_json -e 'print JSON.generate(ARGV[0])[1...-1]' -- "$1"
  else
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
  fi
}

pack_names() {
  printf '%s\n' 'release-ready app-store-ready startup-mvp security performance notion-hygiene'
}

print_packs() {
  verbose="$1"
  if [ "$verbose" -eq 0 ]; then
    pack_names
    return 0
  fi
  for goal_pack in $(pack_names); do
    loops=$(pack_loops "$goal_pack" | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    printf '%s: %s\n' "$goal_pack" "$loops"
  done
}

valid_pack() {
  case "$1" in
    release-ready|app-store-ready|startup-mvp|security|performance|notion-hygiene) return 0 ;;
    *) return 1 ;;
  esac
}

pack_loops() {
  case "$1" in
    release-ready)
      printf '%s\n' test architecture code-hygiene docs-sync security pr-readiness
      ;;
    app-store-ready)
      printf '%s\n' test accessibility screenshots metadata purchases privacy pr-readiness
      ;;
    startup-mvp)
      printf '%s\n' scope-cut deploy analytics onboarding docs-sync pr-readiness
      ;;
    security)
      printf '%s\n' secrets auth permissions dependency-audit threat-review handoff
      ;;
    performance)
      printf '%s\n' baseline latency bundle-size query-optimization regression-check handoff
      ;;
    notion-hygiene)
      printf '%s\n' issue-board-sync docs-sync decisions handoffs stale-links pr-readiness
      ;;
    *)
      printf '%s\n' test docs-sync pr-readiness
      ;;
  esac
}

pack_weight() {
  case "$1" in
    security|pr-readiness|test|auth|permissions|purchases|privacy) printf '2\n' ;;
    *) printf '1\n' ;;
  esac
}

ensure_orca_fallback() {
  dir=$(orca_dir)
  mkdir -p "$dir/docs" "$dir/runs" "$dir/handoffs" "$dir/packs" "$dir/loops" "$dir/notion/outbox" "$dir/notion/synced"
  [ -f "$dir/project.md" ] || cat > "$dir/project.md" <<'EOF'
# ORCA Project

Canonical state: Notion when configured; markdown fallback otherwise.

Configure Notion by setting project/page/data-source IDs in `.orca/config.env`.
Linear stays optional and explicit.
EOF
  [ -f "$dir/issues.md" ] || cat > "$dir/issues.md" <<'EOF'
# ORCA Issues

| Status | Priority | Issue | Files | Action | Verify | Done | ACs |
| --- | --- | --- | --- | --- | --- | --- | --- |
EOF
  [ -f "$dir/decisions.md" ] || printf '# ORCA Decisions\n' > "$dir/decisions.md"
  [ -f "$dir/config.env" ] || cat > "$dir/config.env" <<'EOF'
project_management=notion
documentation=notion
issues=notion
fallback=markdown
notion_dashboard_page_id=
notion_projects_data_source_id=
notion_project_page_id=
notion_issue_board_data_source_id=
notion_sync_command=
linear_workspace=
linear_team=
linear_project_id=
markdown_root=.orca
EOF
  [ -f "$dir/packs/builtin.md" ] || cat > "$dir/packs/builtin.md" <<'EOF'
# Built-in ORCA Loop Packs

- release-ready: tests, architecture, hygiene, docs, security, PR readiness.
- app-store-ready: release-ready plus accessibility, screenshots, metadata, purchases, privacy.
- startup-mvp: scope cut, deployability, analytics, onboarding, docs.
- security: secrets, auth, permissions, dependency audit, threat review.
- performance: baseline, latency, bundle size, query optimization, regression checks.
- notion-hygiene: issue board sync, docs, decisions, handoffs, stale-link cleanup.

Each loop must define goal, measurement, action, stop condition, budget, handoff.
EOF
}

load_config() {
  ensure_orca_fallback
  dir=$(orca_dir)
  project_management=notion
  documentation=notion
  issues=notion
  fallback=markdown
  notion_dashboard_page_id=
  notion_projects_data_source_id=
  notion_project_page_id=
  notion_issue_board_data_source_id=
  notion_sync_command=
  linear_workspace=
  linear_team=
  linear_project_id=
  markdown_root=.orca
  # shellcheck disable=SC1090
  . "$dir/config.env"
  if [ -n "${ORCA_NOTION_SYNC_COMMAND:-}" ]; then
    notion_sync_command=$ORCA_NOTION_SYNC_COMMAND
  fi
}

canonical_backend() {
  load_config
  if [ "${issues:-}" = "notion" ] && [ -n "${notion_issue_board_data_source_id:-}" ]; then
    printf 'notion\n'
  else
    printf 'markdown\n'
  fi
}

write_notion_payload() {
  action="$1"
  payload="$2"
  load_config
  backend=$(canonical_backend)
  dir=$(notion_dir)
  mkdir -p "$dir/outbox" "$dir/synced"
  path="$dir/outbox/$(now_utc)-$action-$goal_slug-${phase:-unknown}-${cycles_done:-0}.json"
  {
    printf '{\n'
    printf '  "schema_version": 1,\n'
    printf '  "payload_type": "goal_event",\n'
    printf '  "action": "%s",\n' "$(json_escape "$action")"
    printf '  "canonical_backend": "%s",\n' "$(json_escape "$backend")"
    printf '  "project_page_id": "%s",\n' "$(json_escape "${notion_project_page_id:-}")"
    printf '  "issue_board_data_source_id": "%s",\n' "$(json_escape "${notion_issue_board_data_source_id:-}")"
    printf '  "goal": "%s",\n' "$(json_escape "$goal")"
    printf '  "goal_slug": "%s",\n' "$(json_escape "$goal_slug")"
    printf '  "phase": "%s",\n' "$(json_escape "$phase")"
    printf '  "pack": "%s",\n' "$(json_escape "$pack")"
    printf '  "payload": %s,\n' "$payload"
    printf '  "updated_at": "%s"\n' "$(now_utc)"
    printf '}\n'
  } > "$path"
  if sync_notion_payload_file "$path" >/dev/null 2>&1; then
    printf '%s\n' "$dir/synced/$(basename "$path")"
    return 0
  fi
  printf '%s\n' "$path"
}

write_notion_outbox_payload() {
  action="$1"
  payload="$2"
  load_config
  backend=$(canonical_backend)
  dir=$(notion_dir)
  mkdir -p "$dir/outbox" "$dir/synced"
  path="$dir/outbox/$(now_utc)-$action-$goal_slug-${phase:-unknown}-${cycles_done:-0}.json"
  {
    printf '{\n'
    printf '  "schema_version": 1,\n'
    printf '  "payload_type": "goal_event",\n'
    printf '  "action": "%s",\n' "$(json_escape "$action")"
    printf '  "canonical_backend": "%s",\n' "$(json_escape "$backend")"
    printf '  "project_page_id": "%s",\n' "$(json_escape "${notion_project_page_id:-}")"
    printf '  "issue_board_data_source_id": "%s",\n' "$(json_escape "${notion_issue_board_data_source_id:-}")"
    printf '  "goal": "%s",\n' "$(json_escape "$goal")"
    printf '  "goal_slug": "%s",\n' "$(json_escape "$goal_slug")"
    printf '  "phase": "%s",\n' "$(json_escape "$phase")"
    printf '  "pack": "%s",\n' "$(json_escape "$pack")"
    printf '  "payload": %s,\n' "$payload"
    printf '  "updated_at": "%s"\n' "$(now_utc)"
    printf '}\n'
  } > "$path"
  printf '%s\n' "$path"
}

validate_notion_payload_file() {
  payload_file="$1"
  [ -f "$payload_file" ] || {
    printf 'Notion payload not found: %s\n' "$payload_file" >&2
    return 1
  }
  [ -s "$payload_file" ] || {
    printf 'Notion payload is empty: %s\n' "$payload_file" >&2
    return 1
  }
  if command -v ruby >/dev/null 2>&1; then
    ruby_json -e '
      data = JSON.parse(File.read(ARGV[0]))
      raise "unsupported schema_version" unless data["schema_version"] == 1
      raise "unsupported payload_type" unless data["payload_type"] == "goal_event"
      %w[action canonical_backend goal_slug phase updated_at].each do |field|
        raise "missing #{field}" unless data[field].is_a?(String) && !data[field].empty?
      end
      raise "missing payload" unless data["payload"].is_a?(Hash)
    ' "$payload_file" 2>/dev/null || {
      printf 'Malformed Notion payload: %s\n' "$payload_file" >&2
      return 1
    }
  else
    grep -q '"schema_version"[[:space:]]*:[[:space:]]*1' "$payload_file" &&
    grep -q '"payload_type"[[:space:]]*:[[:space:]]*"goal_event"' "$payload_file" &&
    grep -q '"action"' "$payload_file" &&
      grep -q '"canonical_backend"' "$payload_file" &&
      grep -q '"goal_slug"' "$payload_file" &&
      grep -q '"phase"' "$payload_file" &&
      grep -q '"updated_at"' "$payload_file" &&
      grep -q '"payload"' "$payload_file" || {
      printf 'Malformed Notion payload: %s\n' "$payload_file" >&2
      return 1
    }
  fi
}

sync_notion_payload_file() {
  payload_file="$1"
  load_config
  dir=$(notion_dir)
  mkdir -p "$dir/outbox" "$dir/synced"
  validate_notion_payload_file "$payload_file" || return 1
  [ -n "${notion_sync_command:-}" ] || {
    printf 'No Notion sync command configured. Set ORCA_NOTION_SYNC_COMMAND or notion_sync_command in %s/config.env.\n' "$(orca_dir)" >&2
    return 1
  }
  if [ -x "$notion_sync_command" ]; then
    "$notion_sync_command" "$payload_file" || return $?
  else
    sh -c "$notion_sync_command \"\$1\"" sh "$payload_file" || return $?
  fi
  synced_path="$dir/synced/$(basename "$payload_file")"
  mv "$payload_file" "$synced_path"
  printf '%s\n' "$synced_path"
}

orca_notion_payload() {
  [ "$#" -gt 0 ] || {
    printf 'Usage: orca notion payload --example | --validate PATH [--json]\n' >&2
    return 1
  }
  case "$1" in
    --example)
      shift
      [ "$#" -eq 0 ] || {
        printf 'Usage: orca notion payload --example\n' >&2
        return 1
      }
      printf '{\n'
      printf '  "schema_version": 1,\n'
      printf '  "payload_type": "goal_event",\n'
      printf '  "action": "goal_unified",\n'
      printf '  "canonical_backend": "notion",\n'
      printf '  "project_page_id": "",\n'
      printf '  "issue_board_data_source_id": "",\n'
      printf '  "goal": "make this production ready",\n'
      printf '  "goal_slug": "make-this-production-ready",\n'
      printf '  "phase": "handoff",\n'
      printf '  "pack": "release-ready",\n'
      printf '  "payload": {\n'
      printf '    "issue": "Run /goal loop for make this production ready",\n'
      printf '    "status": "Done",\n'
      printf '    "readiness_score": 100,\n'
      printf '    "handoff_path": ".orca/handoffs/make-this-production-ready.md",\n'
      printf '    "cycles_done": 1,\n'
      printf '    "max_cycles": 1\n'
      printf '  },\n'
      printf '  "updated_at": "%s"\n' "$(now_utc)"
      printf '}\n'
      ;;
    --validate)
      shift
      json=0
      for arg in "$@"; do
        [ "$arg" = "--json" ] && json=1
      done
      if [ "$#" -eq 0 ] || [ "${1#--}" != "$1" ]; then
        if [ "$json" -eq 1 ]; then
          printf '{"target":"","valid":false,"ok":false,"error":"PATH is required"}\n'
        else
          printf 'Usage: orca notion payload --validate PATH [--json]\n' >&2
        fi
        return 1
      fi
      target=$1
      shift
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --json)
            ;;
          *)
            printf 'orca: unknown notion payload option: %s\n' "$1" >&2
            return 2
            ;;
        esac
        shift
      done
      validate_target=$target
      tmp_payload=
      if [ "$target" = "-" ]; then
        tmp_payload=$(mktemp "${TMPDIR:-/tmp}/orca-notion-payload.XXXXXX")
        cat > "$tmp_payload"
        validate_target=$tmp_payload
      fi
      if validate_notion_payload_file "$validate_target" >/dev/null; then
        valid=true
        status=0
      else
        valid=false
        status=1
      fi
      [ -z "$tmp_payload" ] || rm -f "$tmp_payload"
      if [ "$json" -eq 1 ]; then
        printf '{"target":"%s","valid":%s,"ok":%s}\n' "$(json_escape "$target")" "$valid" "$valid"
      elif [ "$status" -eq 0 ]; then
        printf 'notion-payload: valid %s\n' "$target"
      else
        printf 'notion-payload: invalid %s\n' "$target" >&2
      fi
      return "$status"
      ;;
    -h|--help)
      printf 'Usage: orca notion payload --example | --validate PATH [--json]\n'
      ;;
    *)
      printf 'Usage: orca notion payload --example | --validate PATH [--json]\n' >&2
      return 1
      ;;
  esac
}

orca_notion_handoff() {
  issue=
  status="In progress"
  note=
  goal=
  json=0
  for arg in "$@"; do
    [ "$arg" = "--json" ] && json=1
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --issue)
        if [ "$#" -lt 2 ] || [ "${2#--}" != "$2" ]; then
          if [ "$json" -eq 1 ]; then
            printf '{"ok":false,"error":"--issue requires a value"}\n'
          else
            printf '%s\n' '--issue requires a value' >&2
          fi
          return 1
        fi
        issue="$2"
        shift 2
        ;;
      --status)
        if [ "$#" -lt 2 ] || [ "${2#--}" != "$2" ]; then
          if [ "$json" -eq 1 ]; then
            printf '{"ok":false,"error":"--status requires a value"}\n'
          else
            printf '%s\n' '--status requires a value' >&2
          fi
          return 1
        fi
        status="$2"
        shift 2
        ;;
      --note)
        if [ "$#" -lt 2 ] || [ "${2#--}" != "$2" ]; then
          if [ "$json" -eq 1 ]; then
            printf '{"ok":false,"error":"--note requires a value"}\n'
          else
            printf '%s\n' '--note requires a value' >&2
          fi
          return 1
        fi
        note="$2"
        shift 2
        ;;
      --goal)
        if [ "$#" -lt 2 ] || [ "${2#--}" != "$2" ]; then
          if [ "$json" -eq 1 ]; then
            printf '{"ok":false,"error":"--goal requires a value"}\n'
          else
            printf '%s\n' '--goal requires a value' >&2
          fi
          return 1
        fi
        goal="$2"
        shift 2
        ;;
      --json)
        shift
        ;;
      -h|--help)
        printf 'Usage: orca notion handoff --issue TITLE [--status STATUS] [--note TEXT] [--goal GOAL] [--json]\n'
        return 0
        ;;
      *)
        if [ "$json" -eq 1 ]; then
          printf '{"ok":false,"error":"unknown notion handoff option: %s"}\n' "$(json_escape "$1")"
        else
          printf 'orca: unknown notion handoff option: %s\n' "$1" >&2
        fi
        return 2
        ;;
    esac
  done
  [ -n "$issue" ] || {
    if [ "$json" -eq 1 ]; then
      printf '{"ok":false,"error":"--issue is required"}\n'
    else
      printf '%s\n' '--issue is required' >&2
    fi
    return 1
  }
  [ -n "$goal" ] || goal="$issue"
  goal_slug=$(slugify "$goal")
  [ -n "$goal_slug" ] || goal_slug="notion-handoff"
  phase="handoff"
  pack="manual"
  cycles_done=0
  payload=$(printf '{"issue": "%s", "status": "%s", "note": "%s", "source": "manual_notion_handoff"}' "$(json_escape "$issue")" "$(json_escape "$status")" "$(json_escape "$note")")
  payload_path=$(write_notion_outbox_payload "manual_handoff" "$payload")
  if [ "$json" -eq 1 ]; then
    printf '{"payload_path":"%s","issue":"%s","status":"%s","ok":true}\n' "$(json_escape "$payload_path")" "$(json_escape "$issue")" "$(json_escape "$status")"
  else
    printf '%s\n' "$payload_path"
  fi
}

orca_notion_adapter() {
  adapter="$root/scripts/orca-notion-sync-adapter.sh"
  [ -x "$adapter" ] || {
    printf 'Notion adapter script is not executable: %s\n' "$adapter" >&2
    return 1
  }
  [ "$#" -gt 0 ] || {
    printf 'Usage: orca notion adapter --check PAYLOAD | --json-check PAYLOAD | --doctor PAYLOAD | --dry-run PAYLOAD\n' >&2
    return 1
  }
  case "$1" in
    --check|--summary)
      shift
      [ "$#" -eq 1 ] || {
        printf 'Usage: orca notion adapter --check PAYLOAD\n' >&2
        return 1
      }
      "$adapter" --summary "$1"
      ;;
    --json-check|--json-summary)
      shift
      if [ "$#" -ne 1 ] || [ "${1#--}" != "$1" ]; then
        printf '{"ok":false,"error":"PAYLOAD is required","target":""}\n'
        return 1
      fi
      if ! validate_notion_payload_file "$1" >/dev/null 2>/dev/null; then
        printf '{"ok":false,"error":"Malformed Notion payload","target":"%s"}\n' "$(json_escape "$1")"
        return 1
      fi
      "$adapter" --json-summary "$1"
      ;;
    --doctor)
      shift
      if [ "$#" -ne 1 ] || [ "${1#--}" != "$1" ]; then
        printf '{"backend":null,"adapter":null,"ok":false,"error":"PAYLOAD is required","target":""}\n'
        return 1
      fi
      if ! validate_notion_payload_file "$1" >/dev/null 2>/dev/null; then
        printf '{"backend":null,"adapter":null,"ok":false,"error":"Malformed Notion payload","target":"%s"}\n' "$(json_escape "$1")"
        return 1
      fi
      command -v ruby >/dev/null 2>&1 || {
        printf 'Ruby is required for adapter doctor JSON.\n' >&2
        return 1
      }
      backend_json=$(mktemp "${TMPDIR:-/tmp}/orca-notion-backend-doctor.XXXXXX")
      adapter_json=$(mktemp "${TMPDIR:-/tmp}/orca-notion-adapter-doctor.XXXXXX")
      orca_notion_doctor --json > "$backend_json"
      "$adapter" --json-summary "$1" > "$adapter_json" || {
        status=$?
        rm -f "$backend_json" "$adapter_json"
        return "$status"
      }
      ruby_json - "$backend_json" "$adapter_json" <<'RUBY'
backend = JSON.parse(File.read(ARGV.fetch(0)))
adapter = JSON.parse(File.read(ARGV.fetch(1)))
ok = backend.fetch("ready", false) && adapter.fetch("ok", false) && adapter.fetch("live_ready", false)
puts JSON.generate({ "backend" => backend, "adapter" => adapter, "ok" => ok })
RUBY
      status=$?
      rm -f "$backend_json" "$adapter_json"
      return "$status"
      ;;
    --dry-run)
      shift
      if [ "$#" -ne 1 ] || [ "${1#--}" != "$1" ]; then
        printf '%s\n' 'PAYLOAD is required' >&2
        return 1
      fi
      validate_notion_payload_file "$1" >/dev/null || return 1
      "$adapter" --dry-run "$1"
      ;;
    -h|--help)
      printf 'Usage: orca notion adapter --check PAYLOAD | --json-check PAYLOAD | --doctor PAYLOAD | --dry-run PAYLOAD\n'
      printf '\n'
      printf '  --json-check validates payload shape and adapter plan readiness.\n'
      printf '  --doctor combines backend readiness, adapter readiness, and live sync readiness as top-level ok.\n'
      ;;
    *)
      printf 'Usage: orca notion adapter --check PAYLOAD | --json-check PAYLOAD | --doctor PAYLOAD | --dry-run PAYLOAD\n' >&2
      return 1
      ;;
  esac
}

orca_notion_sync() {
  dry_run=0
  json=0
  target=--all
  for arg in "$@"; do
    [ "$arg" = "--json" ] && json=1
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dry-run)
        dry_run=1
        ;;
      --json)
        ;;
      --all)
        target=--all
        ;;
      -h|--help)
        printf 'Usage: orca notion sync [--dry-run] [--json] [PAYLOAD|--all]\n'
        return 0
        ;;
      *)
        if [ "${1#--}" != "$1" ]; then
          if [ "$json" -eq 1 ]; then
            printf '{"dry_run":%s,"target":"%s","valid":0,"synced":0,"failed":1,"ok":false,"error":"unknown notion sync option: %s"}\n' "$([ "$dry_run" -eq 1 ] && printf true || printf false)" "$(json_escape "$1")" "$(json_escape "$1")"
          else
            printf 'orca: unknown notion sync option: %s\n' "$1" >&2
          fi
          return 2
        fi
        target="$1"
        ;;
    esac
    shift
  done
  load_config
  dir=$(notion_dir)
  mkdir -p "$dir/outbox" "$dir/synced"
  synced=0
  failed=0
  case "$target" in
    --all)
      found=0
      for payload_file in "$dir"/outbox/*.json; do
        [ -e "$payload_file" ] || continue
        found=1
        if [ "$dry_run" -eq 1 ]; then
          if validate_notion_payload_file "$payload_file" >/dev/null; then
            synced=$((synced + 1))
          else
            failed=$((failed + 1))
          fi
        elif sync_notion_payload_file "$payload_file" >/dev/null; then
          synced=$((synced + 1))
        else
          failed=$((failed + 1))
        fi
      done
      [ "$found" -eq 1 ] || {
        if [ "$json" -eq 1 ]; then
          printf '{"dry_run":%s,"target":"--all","valid":0,"synced":0,"failed":0,"ok":true}\n' "$([ "$dry_run" -eq 1 ] && printf true || printf false)"
        else
          printf 'notion-sync: no payloads in %s/outbox\n' "$dir"
        fi
        return 0
      }
      ;;
    *)
      if [ "$dry_run" -eq 1 ]; then
        if validate_notion_payload_file "$target" >/dev/null; then
          synced=1
        else
          failed=1
        fi
      elif sync_notion_payload_file "$target" >/dev/null; then
        synced=1
      else
        failed=1
      fi
      ;;
  esac
  if [ "$failed" -eq 0 ]; then
    ok=true
  else
    ok=false
  fi
  if [ "$json" -eq 1 ]; then
    printf '{'
    if [ "$dry_run" -eq 1 ]; then
      printf '"dry_run":true,'
      printf '"target":"%s",' "$(json_escape "$target")"
      printf '"valid":%s,' "$synced"
      printf '"synced":0,'
    else
      printf '"dry_run":false,'
      printf '"target":"%s",' "$(json_escape "$target")"
      printf '"valid":0,'
      printf '"synced":%s,' "$synced"
    fi
    printf '"failed":%s,' "$failed"
    printf '"ok":%s' "$ok"
    printf '}\n'
  elif [ "$dry_run" -eq 1 ]; then
    printf 'notion-sync: dry-run valid=%s failed=%s\n' "$synced" "$failed"
  else
    printf 'notion-sync: synced=%s failed=%s\n' "$synced" "$failed"
  fi
  [ "$failed" -eq 0 ]
}

orca_notion_outbox() {
  json=0
  for arg in "$@"; do
    [ "$arg" = "--json" ] && json=1
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json)
        ;;
      -h|--help)
        printf 'Usage: orca notion outbox [--json]\n'
        return 0
        ;;
      *)
        if [ "$json" -eq 1 ]; then
          printf '{"ok":false,"error":"unknown notion outbox option: %s"}\n' "$(json_escape "$1")"
          return 2
        fi
        printf 'orca: unknown notion outbox option: %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift
  done

  load_config
  dir=$(notion_dir)
  mkdir -p "$dir/outbox" "$dir/synced"
  outbox_count=$(count_json_files "$dir/outbox")
  synced_count=$(count_json_files "$dir/synced")
  if [ "$json" -eq 1 ]; then
    printf '{'
    printf '"notion_dir":"%s",' "$(json_escape "$dir")"
    printf '"outbox_count":%s,' "$outbox_count"
    printf '"synced_count":%s,' "$synced_count"
    printf '"outbox":['
    first=1
    for payload_file in "$dir"/outbox/*.json; do
      [ -e "$payload_file" ] || continue
      if [ "$first" -eq 1 ]; then
        first=0
      else
        printf ','
      fi
      printf '"%s"' "$(json_escape "$payload_file")"
    done
    printf '],'
    printf '"ok":true'
    printf '}'
    printf '\n'
    return 0
  fi

  printf 'notion outbox: %s payload(s)\n' "$outbox_count"
  printf 'notion synced: %s payload(s)\n' "$synced_count"
  for payload_file in "$dir"/outbox/*.json; do
    [ -e "$payload_file" ] || continue
    printf '%s\n' "$payload_file"
  done
}

orca_notion_doctor() {
  strict=0
  json=0
  for arg in "$@"; do
    [ "$arg" = "--json" ] && json=1
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --strict)
        strict=1
        ;;
      --json)
        ;;
      -h|--help)
        printf 'Usage: orca notion doctor [--strict] [--json]\n'
        return 0
        ;;
      *)
        if [ "$json" -eq 1 ]; then
          printf '{"ok":false,"ready":false,"error":"unknown notion doctor option: %s"}\n' "$(json_escape "$1")"
          return 2
        fi
        printf 'orca: unknown notion doctor option: %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift
  done

  load_config
  failed=0
  dir=$(notion_dir)
  if [ -n "${notion_issue_board_data_source_id:-}" ]; then
    issue_board_configured=true
  else
    issue_board_configured=false
    failed=1
  fi
  if [ -n "${notion_project_page_id:-}" ]; then
    project_page_configured=true
  else
    project_page_configured=false
  fi
  if [ -z "${notion_sync_command:-}" ]; then
    sync_command_status=missing
    failed=1
  elif [ -x "$notion_sync_command" ]; then
    sync_command_status=executable
  else
    sync_command_status=configured_shell_command
  fi
  outbox_count=$(count_json_files "$dir/outbox")
  synced_count=$(count_json_files "$dir/synced")
  if [ -n "$linear_workspace$linear_team$linear_project_id" ]; then
    linear_configured=true
  else
    linear_configured=false
  fi
  if [ "$failed" -eq 0 ]; then
    ready=true
  else
    ready=false
  fi

  if [ "$json" -eq 1 ]; then
    printf '{'
    printf '"notion_issue_board_configured":%s,' "$issue_board_configured"
    printf '"notion_project_page_configured":%s,' "$project_page_configured"
    printf '"notion_sync_command_status":"%s",' "$sync_command_status"
    printf '"notion_outbox_count":%s,' "$outbox_count"
    printf '"notion_synced_count":%s,' "$synced_count"
    printf '"linear_configured":%s,' "$linear_configured"
    printf '"ready":%s,' "$ready"
    printf '"ok":%s' "$ready"
    printf '}\n'
  else
    printf 'notion issue board: '
    if [ "$issue_board_configured" = true ]; then
      printf 'configured\n'
    else
      printf 'missing\n'
    fi
    printf 'notion project page: '
    if [ "$project_page_configured" = true ]; then
      printf 'configured\n'
    else
      printf 'missing\n'
    fi
    printf 'notion sync command: '
    case "$sync_command_status" in
      missing) printf 'missing\n' ;;
      executable) printf 'executable\n' ;;
      configured_shell_command) printf 'configured shell command\n' ;;
    esac
    printf 'notion outbox: %s payload(s)\n' "$outbox_count"
    printf 'notion synced: %s payload(s)\n' "$synced_count"
    if [ "$linear_configured" = true ]; then
      printf 'linear: configured optional adapter\n'
    else
      printf 'linear: not configured, still optional\n'
    fi
  fi
  [ "$strict" -eq 0 ] || [ "$failed" -eq 0 ]
}

write_state() {
  dir=$(orca_dir)
  state="$dir/state.env"
  tmp="$state.$$"
  {
    printf 'goal=%s\n' "$(shell_quote "$goal")"
    printf 'goal_slug=%s\n' "$(shell_quote "$goal_slug")"
    printf 'phase=%s\n' "$(shell_quote "$phase")"
    printf 'pack=%s\n' "$(shell_quote "$pack")"
    printf 'auto=%s\n' "$(shell_quote "$auto")"
    printf 'max_cycles=%s\n' "$(shell_quote "$max_cycles")"
    printf 'until=%s\n' "$(shell_quote "$until")"
    printf 'cycles_done=%s\n' "$(shell_quote "$cycles_done")"
    printf 'readiness_score=%s\n' "$(shell_quote "$readiness_score")"
    printf 'started_at=%s\n' "$(shell_quote "$started_at")"
    printf 'updated_at=%s\n' "$(shell_quote "$(now_utc)")"
  } > "$tmp"
  mv "$tmp" "$state"
  payload=$(printf '{"readiness_score": %s, "cycles_done": %s, "max_cycles": %s, "until": "%s"}' "$readiness_score" "$cycles_done" "$max_cycles" "$(json_escape "$until")")
  if [ "$(canonical_backend)" = "notion" ]; then
    write_notion_payload "state_updated" "$payload" >/dev/null
  fi
}

read_state() {
  dir=$(orca_dir)
  state="$dir/state.env"
  [ -f "$state" ] || {
    printf 'No ORCA state found. Run `orca goal <outcome>` first.\n' >&2
    exit 1
  }
  # shellcheck disable=SC1090
  . "$state"
}

render_plan() {
  dir=$(orca_dir)
  plan="$dir/runs/$goal_slug-plan.md"
  {
    printf '# ORCA Goal Plan\n\n'
    printf 'Goal: %s\n\n' "$goal"
    printf 'Workflow: clarify -> plan -> apply -> unify -> loop pack -> readiness score -> handoff\n\n'
    printf 'Backend defaults:\n\n'
    printf -- '- PM/docs/issues: Notion when configured\n'
    printf -- '- Fallback: `.orca/` markdown\n'
    printf -- '- Linear: optional adapter only\n\n'
    printf '## Clarify\n\n'
    printf 'Ask only for missing success criteria, scope boundaries, repo/path, backend choice, test/build commands, and do-not-touch areas.\n\n'
    printf '## Acceptance-Driven Tasks\n\n'
    printf '| Task | Files | Action | Verify | Done | ACs |\n'
    printf '| --- | --- | --- | --- | --- | --- |\n'
    printf '| T1 | README.md, bin/orca, .orca/* | Make `/goal` the primary workflow with durable state | `orca progress` | State exists and names next action | AC-1, AC-6 |\n'
    printf '| T2 | .orca/issues.md, .orca/runs/* | Track files/action/verify/done/ACs | Review generated plan | Tasks are executable and checkable | AC-task |\n'
    printf '| T3 | .orca/packs/* | Run selected loop pack and readiness scoring | `orca unify` | Score and handoff written | AC-pack |\n\n'
    printf '## Loop Pack: %s\n\n' "$pack"
    for loop in $(pack_loops "$pack"); do
      printf -- '- [ ] %s: goal, measurement, action, stop condition, budget, handoff\n' "$loop"
    done
    printf '\n## Stop Conditions\n\n'
    printf -- '- acceptance criteria satisfied\n'
    printf -- '- no ready issues remain\n'
    printf -- '- repeated test/build failure\n'
    printf -- '- confidence below threshold\n'
    printf -- '- credentials/context missing\n'
    printf -- '- diff/time/cycle budget reached\n'
    printf -- '- user approval required\n'
  } > "$plan"
  printf '%s\n' "$plan"
}

append_issue() {
  status="$1"
  priority="$2"
  issue="$3"
  files="$4"
  action="$5"
  verify="$6"
  done="$7"
  acs="$8"
  dir=$(orca_dir)
  tmp="$dir/issues.$$"
  needle="| $issue |"
  if [ -f "$dir/issues.md" ]; then
    grep -Fv "$needle" "$dir/issues.md" > "$tmp" || true
    mv "$tmp" "$dir/issues.md"
  fi
  printf '| %s | %s | %s | %s | %s | %s | %s | %s |\n' "$status" "$priority" "$issue" "$files" "$action" "$verify" "$done" "$acs" >> "$dir/issues.md"
}

score_pack() {
  dir=$(orca_dir)
  total=0
  passed=0
  for loop in $(pack_loops "$pack"); do
    weight=$(pack_weight "$loop")
    total=$((total + weight))
    [ -f "$dir/loops/$goal_slug/$loop.pass" ] && passed=$((passed + weight))
  done
  [ "$total" -gt 0 ] || total=1
  printf '%s\n' $((passed * 100 / total))
}

record_loop_evidence() {
  loop="$1"
  result="$2"
  note="$3"
  dir="$(orca_dir)/loops/$goal_slug"
  mkdir -p "$dir"
  {
    printf 'loop=%s\n' "$loop"
    printf 'result=%s\n' "$result"
    printf 'note=%s\n' "$note"
    printf 'updated_at=%s\n' "$(now_utc)"
  } > "$dir/$loop.$result"
}

render_loop_evidence() {
  for loop in $(pack_loops "$pack"); do
    if [ -f "$(orca_dir)/loops/$goal_slug/$loop.pass" ]; then
      printf -- '- pass: %s\n' "$loop"
    else
      printf -- '- open: %s\n' "$loop"
    fi
  done
}

orca_goal() {
  pack="release-ready"
  auto=0
  max_cycles=1
  until="done"
  plan_only=0
  outcome=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --packs)
        verbose=0
        if [ "$#" -gt 1 ]; then
          case "$2" in
            --verbose) verbose=1 ;;
            *) printf 'unknown --packs option: %s\n' "$2" >&2; exit 1 ;;
          esac
        fi
        print_packs "$verbose"
        exit 0
        ;;
      --pack)
        [ "$#" -ge 2 ] || {
          printf '%s\n' '--pack requires a value' >&2
          exit 1
        }
        case "$2" in
          --*) printf '%s\n' '--pack requires a value' >&2; exit 1 ;;
        esac
        pack="$2"
        shift 2
        ;;
      --auto|--autopilot)
        auto=1
        shift
        ;;
      --max-cycles)
        [ "$#" -ge 2 ] || {
          printf '%s\n' '--max-cycles requires a value' >&2
          exit 1
        }
        case "$2" in
          --*) printf '%s\n' '--max-cycles requires a value' >&2; exit 1 ;;
        esac
        max_cycles="$2"
        shift 2
        ;;
      --until)
        [ "$#" -ge 2 ] || {
          printf '%s\n' '--until requires a value' >&2
          exit 1
        }
        case "$2" in
          --*) printf '%s\n' '--until requires a value' >&2; exit 1 ;;
        esac
        until="$2"
        shift 2
        ;;
      --plan-only)
        plan_only=1
        shift
        ;;
      --)
        shift
        break
        ;;
      --*)
        printf 'unknown goal option: %s\n' "$1" >&2
        exit 1
        ;;
      *)
        outcome="${outcome}${outcome:+ }$1"
        shift
        ;;
    esac
  done
  if [ "$#" -gt 0 ]; then
    outcome="${outcome}${outcome:+ }$*"
  fi
  [ -n "$outcome" ] || {
    printf 'Usage: orca goal <outcome> [--pack NAME] [--auto] [--max-cycles N] [--until blocked|done] [--plan-only]\n' >&2
    printf '       orca goal --packs [--verbose]\n' >&2
    exit 1
  }
  case "$max_cycles" in
    *[!0-9]*|"") printf '%s\n' '--max-cycles must be a positive integer' >&2; exit 1 ;;
  esac
  [ "$max_cycles" -gt 0 ] || {
    printf '%s\n' '--max-cycles must be greater than 0' >&2
    exit 1
  }
  case "$until" in
    blocked|done) ;;
    *) printf '%s\n' '--until must be blocked or done' >&2; exit 1 ;;
  esac
  valid_pack "$pack" || {
    printf 'unknown --pack: %s\n' "$pack" >&2
    printf 'valid packs: %s\n' "$(pack_names)" >&2
    exit 1
  }
  ensure_orca_fallback
  goal="$outcome"
  goal_slug=$(slugify "$goal")
  [ -n "$goal_slug" ] || goal_slug="goal"
  phase="clarify"
  cycles_done=0
  readiness_score=0
  started_at=$(now_utc)
  write_state
  phase="plan"
  write_state
  plan_path=$(render_plan)
  append_issue "In progress" "High" "Run /goal loop for $goal" "README.md, bin/orca, .orca/*" "Clarify, plan, apply, unify, score, handoff" "orca progress && orca unify" "Handoff includes readiness score and next action" "AC-1..AC-6"
  record_loop_evidence "docs-sync" "pass" "Plan artifact written at $plan_path"
  record_loop_evidence "issue-board-sync" "pass" "Acceptance-driven issue mirrored locally and queued for Notion when configured"
  backend=$(canonical_backend)
  if [ "$backend" = "notion" ]; then
    payload=$(printf '{"issue": "%s", "status": "In progress", "priority": "High", "files": "README.md, bin/orca, .orca/*", "action": "Clarify, plan, apply, unify, score, handoff", "verify": "orca progress && orca unify", "done": "Handoff includes readiness score and next action", "acs": "AC-1..AC-6", "plan_path": "%s"}' "$(json_escape "Run /goal loop for $goal")" "$(json_escape "$plan_path")")
    notion_payload=$(write_notion_payload "goal_started" "$payload")
  else
    notion_payload=""
  fi
  printf 'ORCA goal started\n'
  printf 'phase: %s\n' "$phase"
  printf 'pack: %s\n' "$pack"
  printf 'canonical: %s\n' "$backend"
  printf 'state: %s/state.env\n' "$(orca_dir)"
  printf 'plan: %s\n' "$plan_path"
  if [ -n "$notion_payload" ]; then
    printf 'notion-sync: %s\n' "$notion_payload"
  fi
  if [ "$plan_only" -eq 1 ]; then
    printf 'next: apply planned tasks, then run `orca unify`\n'
  else
    printf 'next: apply planned tasks, then unify\n'
  fi
  if [ "$auto" -eq 1 ]; then
    printf 'auto: bounded, max_cycles=%s, until=%s\n' "$max_cycles" "$until"
  fi
  if [ "$plan_only" -eq 0 ]; then
    phase="apply"
    write_state
    append_issue "In progress" "High" "Run /goal loop for $goal" "README.md, bin/orca, .orca/*" "Clarify, plan, apply, unify, score, handoff" "orca progress && orca unify" "Handoff includes readiness score and next action" "AC-1..AC-6"
    if [ "$(canonical_backend)" = "notion" ]; then
      payload=$(printf '{"issue": "%s", "status": "In progress", "next": "unify", "plan_path": "%s"}' "$(json_escape "Run /goal loop for $goal")" "$(json_escape "$plan_path")")
      notion_payload=$(write_notion_payload "apply_started" "$payload")
      printf 'notion-sync: %s\n' "$notion_payload"
    fi
    orca_unify
  fi
}

orca_progress() {
  if [ "$#" -gt 0 ]; then
    printf 'unknown progress option: %s\n' "$1" >&2
    exit 1
  fi
  read_state
  printf 'goal: %s\n' "$goal"
  printf 'phase: %s\n' "$phase"
  printf 'pack: %s\n' "$pack"
  printf 'canonical: %s\n' "$(canonical_backend)"
  printf 'readiness: %s%%\n' "$readiness_score"
  case "$phase" in
    plan) printf 'next: apply acceptance-driven tasks\n' ;;
    apply) printf 'next: run `orca unify`\n' ;;
    unify) printf 'next: run loop pack and write handoff\n' ;;
    handoff|done) printf 'next: review handoff or start next /goal\n' ;;
    *) printf 'next: inspect .orca/state.env\n' ;;
  esac
}

orca_unify() {
  if [ "$#" -gt 0 ]; then
    printf 'unknown unify option: %s\n' "$1" >&2
    exit 1
  fi
  read_state
  dir=$(orca_dir)
  phase="handoff"
  cycles_done=$((cycles_done + 1))
  handoff="$dir/handoffs/$goal_slug.md"
  record_loop_evidence "handoffs" "pass" "Handoff artifact written at $handoff"
  record_loop_evidence "docs-sync" "pass" "Plan and handoff artifacts written"
  record_loop_evidence "issue-board-sync" "pass" "Issue status mirrored and Notion sync payload generated when configured"
  readiness_score=$(score_pack)
  if [ "$readiness_score" -ge 80 ]; then
    issue_status="Done"
  else
    issue_status="In progress"
  fi
  append_issue "$issue_status" "High" "Run /goal loop for $goal" "README.md, bin/orca, .orca/*" "Clarify, plan, apply, unify, score, handoff" "orca progress && orca unify" "Handoff includes readiness score and next action" "AC-1..AC-6"
  {
    printf '# ORCA Handoff\n\n'
    printf 'Goal: %s\n\n' "$goal"
    printf 'Workflow: clarify -> plan -> apply -> unify -> loop pack -> readiness score -> handoff\n\n'
    printf 'Pack: %s\n\n' "$pack"
    printf 'Readiness score: %s%%\n\n' "$readiness_score"
    printf 'Loop evidence:\n\n'
    render_loop_evidence
    printf '\n'
    printf 'Cycles: %s/%s\n\n' "$cycles_done" "$max_cycles"
    printf 'Stop conditions checked:\n\n'
    printf -- '- bounded cycles: %s\n' "$max_cycles"
    printf -- '- until: %s\n' "$until"
    printf -- '- no infinite autonomous mode\n'
    printf -- '- Notion canonical when configured; markdown fallback available\n'
    printf -- '- Linear preserved as optional adapter\n\n'
    if [ "${auto:-0}" -eq 1 ]; then
      printf 'Autonomous mode: stopped after %s cycle(s); max_cycles=%s; reason=no ready issues remain or handoff reached.\n\n' "$cycles_done" "$max_cycles"
    fi
    printf 'Next action: update Notion issue status and run validation gates.\n'
  } > "$handoff"
  write_state
  backend=$(canonical_backend)
  if [ "$backend" = "notion" ]; then
    payload=$(printf '{"issue": "%s", "status": "%s", "readiness_score": %s, "handoff_path": "%s", "cycles_done": %s, "max_cycles": %s}' "$(json_escape "Run /goal loop for $goal")" "$issue_status" "$readiness_score" "$(json_escape "$handoff")" "$cycles_done" "$max_cycles")
    notion_payload=$(write_notion_payload "goal_unified" "$payload")
  else
    notion_payload=""
  fi
  printf 'ORCA unified\n'
  printf 'canonical: %s\n' "$backend"
  printf 'readiness: %s%%\n' "$readiness_score"
  printf 'handoff: %s\n' "$handoff"
  if [ -n "$notion_payload" ]; then
    printf 'notion-sync: %s\n' "$notion_payload"
  fi
}

orca_backend_status() {
  json=0
  for arg in "$@"; do
    [ "$arg" = "--json" ] && json=1
  done
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --json)
        ;;
      -h|--help)
        printf 'Usage: orca backend status [--json]\n'
        return 0
        ;;
      *)
        if [ "$json" -eq 1 ]; then
          printf '{"ok":false,"error":"unknown backend status option: %s"}\n' "$(json_escape "$1")"
          return 2
        fi
        printf 'orca: unknown backend status option: %s\n' "$1" >&2
        return 2
        ;;
    esac
    shift
  done

  load_config
  dir=$(orca_dir)
  notion_state_dir=$(notion_dir)
  active_backend=$(canonical_backend)
  outbox_count=$(count_json_files "$notion_state_dir/outbox")
  synced_count=$(count_json_files "$notion_state_dir/synced")
  if [ -n "$notion_issue_board_data_source_id" ]; then
    notion_configured=true
    notion_status=configured
  else
    notion_configured=false
    notion_status=markdown_fallback
  fi
  if [ -z "${notion_sync_command:-}" ]; then
    notion_sync_status=outbox_mirror_only
  elif [ -x "$notion_sync_command" ]; then
    notion_sync_status=executable
  else
    notion_sync_status=configured_shell_command
  fi
  if [ -n "$linear_workspace$linear_team$linear_project_id" ]; then
    linear_configured=true
  else
    linear_configured=false
  fi

  if [ "$json" -eq 1 ]; then
    printf '{'
    printf '"canonical_pm":"%s",' "$(json_escape "$project_management")"
    printf '"canonical_docs":"%s",' "$(json_escape "$documentation")"
    printf '"canonical_issues":"%s",' "$(json_escape "$issues")"
    printf '"fallback":"%s",' "$(json_escape "$fallback")"
    printf '"orca_dir":"%s",' "$(json_escape "$dir")"
    printf '"active_canonical":"%s",' "$(json_escape "$active_backend")"
    printf '"notion_configured":%s,' "$notion_configured"
    printf '"notion_status":"%s",' "$notion_status"
    printf '"notion_sync_status":"%s",' "$notion_sync_status"
    printf '"notion_dir":"%s",' "$(json_escape "$notion_state_dir")"
    printf '"notion_outbox_count":%s,' "$outbox_count"
    printf '"notion_synced_count":%s,' "$synced_count"
    printf '"linear_configured":%s,' "$linear_configured"
    printf '"ok":true'
    printf '}\n'
    return 0
  fi

  printf 'canonical PM: %s\n' "$project_management"
  printf 'canonical docs: %s\n' "$documentation"
  printf 'canonical issues: %s\n' "$issues"
  printf 'fallback: %s at %s\n' "$fallback" "$dir"
  printf 'active canonical: %s\n' "$active_backend"
  if [ "$notion_configured" = true ]; then
    printf 'notion: configured\n'
    if [ "$notion_sync_status" = executable ]; then
      printf 'notion sync: executable\n'
    elif [ "$notion_sync_status" = configured_shell_command ]; then
      printf 'notion sync: configured shell command\n'
    else
      printf 'notion sync: outbox mirror only\n'
    fi
    printf 'notion outbox: %s payload(s)\n' "$outbox_count"
    printf 'notion synced: %s payload(s)\n' "$synced_count"
  else
    printf 'notion: not configured, use markdown fallback\n'
  fi
  if [ "$linear_configured" = true ]; then
    printf 'linear: configured optional adapter\n'
  else
    printf 'linear: not configured, still supported when explicit\n'
  fi
}

if [ "$script_name" != "orca" ]; then
  subcommand="run"
  target_command="$script_name"
else
  subcommand="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  target_command=""
fi

case "$subcommand" in
  help|-h|--help)
    usage
    exit 0
    ;;
  list)
    list_commands
    exit 0
    ;;
  show|path|run)
    if [ "$script_name" = "orca" ]; then
      [ "$#" -gt 0 ] || {
        usage >&2
        exit 1
      }
      target_command="$1"
      shift
    fi
    ;;
  -*)
    if [ "$script_name" = "orca" ]; then
      printf 'unknown top-level option: %s\n' "$subcommand" >&2
      exit 1
    fi
    ;;
  *)
    if [ "$script_name" = "orca" ]; then
      target_command="$subcommand"
      subcommand="run"
    fi
    ;;
esac

if [ "$script_name" = "orca" ]; then
  case "$target_command" in
    goal|/goal)
      orca_goal "$@"
      exit 0
      ;;
    progress)
      orca_progress "$@"
      exit 0
      ;;
    unify)
      orca_unify "$@"
      exit 0
      ;;
    backend)
      if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
        printf 'Usage: orca backend status [--json]\n'
        exit 0
      fi
      if [ "${1:-}" = "status" ]; then
        shift
        orca_backend_status "$@"
        exit $?
      fi
      printf 'Usage: orca backend status [--json]\n' >&2
      exit 1
      ;;
    notion)
      if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "${1:-}" = "help" ]; then
        printf 'Usage: orca notion sync [--dry-run] [--json] [PAYLOAD|--all]\n       orca notion outbox [--json]\n       orca notion handoff --issue TITLE [--status STATUS] [--note TEXT] [--json]\n       orca notion payload --example | --validate PATH [--json]\n       orca notion adapter --check PAYLOAD | --json-check PAYLOAD | --doctor PAYLOAD | --dry-run PAYLOAD\n       orca notion doctor [--strict] [--json]\n'
        exit 0
      fi
      if [ "${1:-}" = "sync" ]; then
        shift
        orca_notion_sync "$@"
        exit $?
      fi
      if [ "${1:-}" = "doctor" ]; then
        shift
        orca_notion_doctor "$@"
        exit $?
      fi
      if [ "${1:-}" = "outbox" ]; then
        shift
        orca_notion_outbox "$@"
        exit $?
      fi
      if [ "${1:-}" = "handoff" ]; then
        shift
        orca_notion_handoff "$@"
        exit $?
      fi
      if [ "${1:-}" = "payload" ]; then
        shift
        orca_notion_payload "$@"
        exit $?
      fi
      if [ "${1:-}" = "adapter" ]; then
        shift
        orca_notion_adapter "$@"
        exit $?
      fi
      printf 'Usage: orca notion sync [--dry-run] [--json] [PAYLOAD|--all]\n       orca notion outbox [--json]\n       orca notion handoff --issue TITLE [--status STATUS] [--note TEXT] [--json]\n       orca notion payload --example | --validate PATH [--json]\n       orca notion adapter --check PAYLOAD | --json-check PAYLOAD | --doctor PAYLOAD | --dry-run PAYLOAD\n       orca notion doctor [--strict] [--json]\n' >&2
      exit 1
      ;;
  esac
fi

file=$(command_file "$target_command")
name=$(normalize_command "$target_command")

case "$subcommand" in
  show)
    cat "$file"
    exit 0
    ;;
  path)
    printf '%s\n' "$file"
    exit 0
    ;;
  run) ;;
  *)
    usage >&2
    exit 1
    ;;
esac

print_only=0
harness="auto"
target_dir=$(pwd)
sandbox="workspace-write"
output_file=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --print)
      print_only=1
      shift
      ;;
    --harness)
      harness="$2"
      shift 2
      ;;
    --target)
      target_dir="$2"
      shift 2
      ;;
    --sandbox)
      sandbox="$2"
      shift 2
      ;;
    --output)
      output_file="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

context="$*"

if [ "$print_only" -eq 1 ]; then
  emit_prompt "$name" "$file" "$context"
  exit 0
fi

if [ "$harness" = "auto" ]; then
  if command -v codex >/dev/null 2>&1; then
    harness="codex"
  else
    harness="generic"
  fi
fi

case "$harness" in
  codex)
    run_codex "$name" "$file" "$target_dir" "$sandbox" "$output_file" "$context"
    ;;
  generic)
    emit_prompt "$name" "$file" "$context"
    ;;
  *)
    printf 'Unsupported harness: %s\n' "$harness" >&2
    exit 1
    ;;
esac
